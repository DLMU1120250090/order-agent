# ============================================================
# Order-Agent 环境配置示例
# 使用方式：复制本文件为 .env 后按需填写
#   cp .env_example .env
# 真实 .env 已在 .gitignore 中排除，请勿提交
# ============================================================

# ===== 基础 LLM（DeepSeek）=====
# DeepSeek API 密钥（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DeepSeek OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 主模型：面向用户的推荐理由与口语化回答
DIET_LLM_MAIN_MODEL=deepseek-v4-flash
# 轻量模型：意图识别、槽位抽取、澄清追问等
DIET_LLM_LIGHT_MODEL=deepseek-v4-flash

# ===== 数据库（MySQL，异步 aiomysql 驱动）=====
DATABASE_URL=mysql+aiomysql://root:change-me@127.0.0.1:3306/diet_agent?charset=utf8mb4

# 多轮对话历史缓存最大轮数
MAX_HISTORY_TURNS=10

# ===== 出行数据采集 API（Mock 模式下不需要，可留空）=====
TRAVEL_ALIYUN_APPCODE=
TRAVEL_ALIYUN_APPKEY=
TRAVEL_ALIYUN_APPSECRET=
TRAVEL_AMAP_KEY=
TRAVEL_AMAP_SECURITY_KEY=
# 和风天气 JWT：api-host + 私钥 PEM(base64)
TRAVEL_QWEATHER_API_HOST=
TRAVEL_QWEATHER_PRIVATE_KEY_B64=
TRAVEL_QWEATHER_PROJECT_ID=
TRAVEL_QWEATHER_CREDENTIAL_ID=

# ===== 浏览器自动化 =====
# 携程浏览器自动化持久化登录目录（正式接入时使用）
TRAVEL_CTRIP_USER_DATA_DIR=
# 真实携程自动化开关（默认开；尝试真实携程，被反爬/登录墙拦截或页面未适配时自动回退 Mock 收银台；置 false 可关闭）
TRAVEL_CTRIP_REAL_ENABLED=true
# 携程国内机票频道入口
TRAVEL_CTRIP_BASE_URL=https://flights.ctrip.com/online/channel/domestic
# 真实携程模式默认显式打开浏览器（非无头）；无头实测被 whaleguard 拦截
TRAVEL_CTRIP_HEADLESS=false
# 浏览器通道：优先本机 Chrome（实测可过鲸盾）；可选 chrome / msedge / chromium
TRAVEL_CTRIP_CHANNEL=chrome
# 收银台二维码测试图片（相对项目根目录，如 qr_code.jpg；留空自动生成占位二维码）
TRAVEL_QR_TEST_IMAGE=qr_code.jpg

# ===== 出行 Agent 开关 =====
# 微信桥（非官方协议，默认关闭）
TRAVEL_ENABLE_WECHAT=false
# Mock 模式：外部数据 API 全部使用内置模拟数据
TRAVEL_MOCK_MODE=true
# 价格监控净节省推送阈值（元）
TRAVEL_PRICE_DROP_THRESHOLD=50
# 预算档位参考价（经济型,舒适型,高端型）
TRAVEL_BUDGET_REFERENCE=300,600,1000
# Mock 收银台自动模拟支付秒数：0=关闭（等用户「付好了」确认）；>0 用于演示第1/2层支付检测
TRAVEL_MOCK_CHECKOUT_AUTO_PAY_SECONDS=8
# 支付检测轮询：前 2 分钟每 30 秒，之后每 90 秒，总超时 15 分钟
TRAVEL_PAYMENT_POLL_SECONDS_FAST=30
TRAVEL_PAYMENT_POLL_SECONDS_SLOW=90
TRAVEL_PAYMENT_MONITOR_TIMEOUT=900

# ===== 钉钉通道（企业内部应用，可选）=====
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_APP_ID=
# 群机器人 Webhook（Stream 模式不需要）
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_CODE=
